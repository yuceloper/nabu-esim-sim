#!/usr/bin/env bash
# Host-side, read-only VSIM discovery. No vendor method invocation.
set -u
out="${1:-nabu-diagnostics-v010-$(date +%Y%m%d-%H%M%S)}"
mkdir -p "$out" || exit 1
if ! adb get-state >/dev/null 2>&1; then echo "ADB device unavailable" >&2; exit 1; fi
capture() {
  local name="$1" cmd="$2" rc=0
  adb shell -T "$cmd" > "$out/$name.txt" 2>&1 || rc=$?
  printf '%s exit=%s\n' "$name" "$rc" | tee -a "$out/status.txt"
}
capture root 'su -c id'
capture daemon 'su -c "getprop init.svc.vendor.vsimservice; pidof vsimd; getprop init.svc.vendor.qcrild"'
capture hal 'su -c lshal'
capture qrtr 'su -c qrtr-lookup'
capture radio 'getprop ro.radio.noril; getprop ro.vendor.radio.noril; getprop ro.baseband'
capture features 'pm list features'
capture firmware 'su -c "sha256sum /vendor/bin/vsimd /vendor/lib/libvsim.so /vendor/lib/vendor.xiaomi.hardware.vsimapp@1.0.so /vendor/firmware_mnt/image/vsimapp*"'
echo '--- VSIM HAL listing ---'
grep -i 'vendor.xiaomi.hardware.vsimapp' "$out/hal.txt" || echo 'Not listed (absence or access failure; inconclusive)'
echo '--- Cellular QMI candidates ---'
awk '$1 ~ /^(1|2|3|5|9|11)$/ {print}' "$out/qrtr.txt"
echo '--- Daemon state / PID / qcrild state ---'
cat "$out/daemon.txt"
printf 'Reports: %s\nInspect and redact before sharing.\n' "$out"
